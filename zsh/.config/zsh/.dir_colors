# This source code is licensed under the MIT license found in the license file.
#
# Extension list and attributes (bold, underline) follow the Nord dircolors port.
# Hues are Nordic (https://github.com/AlexvZyl/nordic.nvim), using the same roles
# as the editor highlights. Truecolor, because those hues are not the ANSI slots:
# Directory is blue1, links and executables are blue2, and the Ghostty port swaps
# palette entries 5 and 6.
#
#   directory, other-writable   blue1    #81A1C1   Directory, TreeFolderName
#   link, exec, fifo, door      blue2    #88C0D0   TreeSymlink, Function
#   archive, media              green    #A3BE8C   green.base
#   socket, block, char         yellow   #EBCB8B   yellow.base
#   crypto                      magenta  #BE9DB8   TreeSpecialFile
#   orphan                      red      #C5727A   error
#   missing                     white1 on red.base #D8DEE9 / #BF616A
#   setuid, capability          white1   #D8DEE9
#   sticky background           blue0    #5E81AC
#   ignored                     gray4    #4C566A   Comment
#                               (no faint: gray4 is already the muted color)

COLOR tty

TERM alacritty
TERM alacritty-direct
TERM ansi
TERM *color*
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM dtterm
TERM dvtm
TERM dvtm-256color
TERM Eterm
TERM eterm-color
TERM fbterm
TERM gnome
TERM gnome-256color
TERM hurd
TERM jfbterm
TERM konsole
TERM konsole-256color
TERM kterm
TERM linux
TERM linux-c
TERM mlterm
TERM putty
TERM putty-256color
TERM rxvt*
TERM rxvt-unicode
TERM rxvt-256color
TERM rxvt-unicode256
TERM screen*
TERM screen-256color
TERM st
TERM st-256color
TERM terminator
TERM tmux*
TERM tmux-256color
TERM vt100
TERM xterm*
TERM xterm-color
TERM xterm-88color
TERM xterm-256color
TERM xterm-kitty

#+-----------------+
#+ Global Defaults +
#+-----------------+
NORMAL 00
RESET 0

FILE 00
DIR 01;38;2;129;161;193
LINK 38;2;136;192;208
MULTIHARDLINK 04;38;2;136;192;208

FIFO 04;01;38;2;136;192;208
SOCK 04;38;2;235;203;139
DOOR 04;01;38;2;136;192;208
BLK 01;38;2;235;203;139
CHR 38;2;235;203;139

ORPHAN 38;2;197;114;122
MISSING 01;38;2;216;222;233;48;2;191;97;106

EXEC 01;38;2;136;192;208

SETUID 01;04;38;2;216;222;233
SETGID 01;04;38;2;216;222;233
CAPABILITY 01;38;2;216;222;233

STICKY_OTHER_WRITABLE 01;38;2;216;222;233;48;2;94;129;172
OTHER_WRITABLE 01;04;38;2;129;161;193
STICKY 04;38;2;216;222;233;48;2;94;129;172

